{
  "name": "SysML v2",
  "scopeName": "source.sysml",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#keywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#identifier"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.block.sysml",
          "begin": "/\\*",
          "end": "\\*/"
        },
        {
          "name": "comment.line.double-slash.sysml",
          "match": "//[^*\\n][^\\n]*"
        },
        {
          "name": "comment.line.double-slash.sysml",
          "match": "//"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.double.sysml",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.sysml"
            }
          ]
        },
        {
          "name": "string.quoted.single.sysml",
          "begin": "'",
          "end": "'",
          "patterns": [
            {
              "match": "\\\\.",
              "name": "constant.character.escape.sysml"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.real.sysml",
          "match": "\\b[0-9]+\\.[0-9]+([eE][+-]?[0-9]+)?\\b|\\b[0-9]+[eE][+-]?[0-9]+\\b"
        },
        {
          "name": "constant.numeric.integer.sysml",
          "match": "\\b[0-9]+\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.sysml",
          "match": "\\b(?:specialization|subclassifier|multiplicity|redefinition|verification|conjugation|differences|interaction|requirement|specializes|stakeholder|allocation|classifier|conjugates|connection|constraint|dependency|disjoining|individual|intersects|occurrence|references|succession|transition|attribute|composite|conjugate|connector|featuring|interface|inverting|metaclass|namespace|nonunique|objective|predicate|protected|redefines|rendering|terminate|timeslice|variation|viewpoint|abstract|allocate|analysis|behavior|constant|datatype|disjoint|featured|function|language|metadata|parallel|snapshot|standard|binding|comment|concern|connect|crosses|default|defined|derived|exhibit|feature|hastype|implies|include|inverse|library|message|ordered|package|perform|portion|private|require|satisfy|subject|subsets|subtype|variant|accept|action|assert|assign|assume|chains|decide|expose|filter|import|istype|locale|member|public|render|return|struct|subset|typing|unions|verify|about|actor|after|alias|assoc|class|const|entry|event|false|first|frame|inout|merge|state|typed|until|while|bind|bool|calc|case|else|enum|exit|expr|flow|fork|from|item|join|loop|meta|null|part|port|send|step|then|true|type|view|when|all|and|def|doc|end|for|inv|new|not|out|ref|rep|use|var|via|xor|as|at|by|do|if|in|of|or|to)\\b"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.sysml",
          "match": "!==|::>|:>>|===|!=|\\*\\*|->|\\.\\.|\\.\\?|::|:=|:>|<=|==|=>|>=|\\?\\?|@@|//|#|\\$|%|&|\\(|\\)|\\*|\\+|,|-|\\.|/|:|;|<|=|>|\\?|@|\\[|\\]|\\^|\\{|\\||\\}|~"
        }
      ]
    },
    "identifier": {
      "patterns": [
        {
          "name": "variable.name.sysml",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    }
  }
}
